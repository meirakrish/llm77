{
  "name": "llm-backend-practice",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p test",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "dev": "node --env-file-if-exists=.env node_modules/ts-node/dist/bin.js src/index.ts",
    "dev:worker": "node --env-file-if-exists=.env node_modules/ts-node/dist/bin.js src/worker.ts",
    "build:worker": "esbuild src/worker.ts --bundle --platform=node --target=node22 --outfile=dist/worker.bundle.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@lancedb/lancedb": "^0.39.0",
    "apache-arrow": "18.1.0",
    "bullmq": "^6.3.11",
    "cors": "^2.8.6",
    "express": "^4.19.2",
    "ioredis": "^6.0.0",
    "ollama": "^0.5.0",
    "pdf-parse": "^2.4.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.11"
  }
}
