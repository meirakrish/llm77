# Copy to .env (git-ignored); `npm run dev`, `npm run dev:worker` and the start scripts load it automatically.

# Shared secret between the backend and the worker. Use the same value on both; generate one with:
#   openssl rand -hex 32
INTERNAL_API_TOKEN=

# Backend only: enables Claude models
# ANTHROPIC_API_KEY=

# Worker only, when the backend runs elsewhere (default http://localhost:3000)
# API_URL=http://localhost:3000
